{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.dailyaibetting.com" }],
      "destination": "https://dailyaibetting.com/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ai-picks",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/grade-picks",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/generate-blog-recap",
      "schedule": "10 14 * * *"
    }
  ],
  "_comment_daily_ai_picks": "daily-ai-picks crons REMOVED 2026-06-02 — report is generated by hiddenbag-v2/scripts/daily-ai-report.mjs (local PM2, $0 Max subprocess, premium BallparkPal+Statcast data) which also posts to Discord + upserts Supabase. Running them here produced a degraded report via PAID OpenRouter (no caches on Vercel/Hetzner) that overwrote the good one. generateFreshReport() also now hard-refuses when caches are absent.",
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Cloudflare-CDN-Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.(?:png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" },
        { "key": "Cloudflare-CDN-Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
